# Avito Реклама API credentials
# Заполни своими данными из кабинета Авито Реклама → Аккаунт → API → «Создать ключ»
# Доступно только пользователю с ролью Администратор.
# После заполнения: chmod 600 config/.env, потом запусти scripts/avito-ads-oauth-setup.sh

AVITO_ADS_CLIENT_ID=
AVITO_ADS_CLIENT_SECRET=

# accountID — числовой ID рекламного аккаунта, под который выпустили ключи.
# Виден в кабинете в URL или через API после первого запроса.
AVITO_ADS_ACCOUNT_ID=

# По умолчанию работаем в песочнице (api.avito.ru/ads-sandbox/).
# Поменяй на prod когда готов лить запросы в боевой кабинет и тратить API-баллы.
AVITO_ADS_MODE=sandbox

# Опционально (для override):
# AVITO_ADS_BASE=https://api.avito.ru
# AVITO_ADS_TOKEN_URL=https://api.avito.ru/token
